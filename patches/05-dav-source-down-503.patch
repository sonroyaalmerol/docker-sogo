+/* When the authentication source (LDAP, ...) is unreachable the credentials
+   were never evaluated, so answering 401 is wrong: DAV clients treat it as
+   "invalid authentication" and drop or re-prompt for stored credentials.
+   RFC 4918 section 11 maps this situation onto 503, which clients retry. */
+- (WOResponse *) _sourceUnavailableInContext: (WOContext *) _ctx
+{
+  WOResponse *r;
+
+  r = [_ctx response];
+  [r setStatus: 503 /* service unavailable */];
+  /* Drop any authentication challenge super may already have emitted: the
+     credentials were never evaluated, so this must not look like one. */
+  [r setHeaders: [NSArray array] forKey: @"www-authenticate"];
+  [r setHeader: @"60" forKey: @"retry-after"];
+  [r setHeader: @"text/plain; charset=utf-8" forKey: @"content-type"];
+  [r setContent: [NSData data]];
+  [r appendContentString: @"Authentication source unavailable"];
+
+  [self logWithFormat: @"authentication source unreachable,"
+        @" answering 503 instead of 401"];
+
+  return r;
+}
+
+- (WOResponse *) preprocessCredentialsInContext: (WOContext *) _ctx
+{
+  WOResponse *r;
+
+  r = [super preprocessCredentialsInContext: _ctx];
+  if (r && [r status] == 401
+      && [SOGoUserManager isAuthenticationSourceUnreachable])
+    r = [self _sourceUnavailableInContext: _ctx];
+
+  return r;
+}
+
+- (BOOL) renderException: (NSException *) _e
+               inContext: (WOContext *) _ctx
+{
+  if ([_e httpStatus] == 401
+      && [SOGoUserManager isAuthenticationSourceUnreachable])
+    {
+      [self _sourceUnavailableInContext: _ctx];
+      return YES;
+    }
+
+  return [super renderException: _e inContext: _ctx];
+}
